# Opcional: origen del Nest para el proxy (misma máquina). Si no se define, Next intenta leer PORT desde ../backend/.env
# BACKEND_ORIGIN=http://localhost:3006

# Opcional: llamada directa desde el navegador al API (sin proxy). Desactiva el uso de rutas relativas /api/...
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
