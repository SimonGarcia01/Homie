NODE_ENV=development
PORT=3006

# Local Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=rental_crm_nest
DB_SYNCHRONIZE=true
DB_SSL=false

# Optional Neon URL for production
# DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require

JWT_SECRET=replace-with-long-secret
JWT_EXPIRES_IN=1d

# Storage (local filesystem)
UPLOADS_DIR=./uploads
UPLOADS_PUBLIC_PREFIX=/uploads
PUBLIC_BASE_URL=http://localhost:3006
